# Cadena de conexión PostgreSQL (Prisma)
DATABASE_URL=postgresql://betcalculator:betcalculator_password@localhost:5432/betcalculator?schema=public

# Puerto del servidor Express
SERVER_PORT=4000

# Origen permitido para CORS
CORS_ORIGIN=http://localhost:5173
