# ==============================================
# BetCalculator Pro - Variables de entorno (RAÍZ)
# Copiar a .env y ajustar los valores.
# ==============================================

# PostgreSQL (usado por docker-compose y por Prisma)
POSTGRES_USER=betcalculator
POSTGRES_PASSWORD=betcalculator_password
POSTGRES_DB=betcalculator
POSTGRES_PORT=5432

# Cadena de conexión de Prisma
DATABASE_URL=postgresql://betcalculator:betcalculator_password@localhost:5432/betcalculator?schema=public

# Backend
SERVER_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:4000/api
